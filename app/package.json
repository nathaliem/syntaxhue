{
  "name": "app",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:api": "node scripts/build-api.mjs",
    "check:api": "node scripts/build-api.mjs && git diff --exit-code --stat -- api",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run build && npm run check:api && npm run budget && npm test",
    "e2e": "playwright test",
    "budget": "node ci/budget.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/langs": "^4.6.0",
    "@vercel/analytics": "^2.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.63.2",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.1",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^29.1.1",
    "oxlint": "^1.90.0",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
