exports[`port sublime > matches its snapshot 1`] = `
[
  {
    "content": "{
  "name": "Fixture Dark",
  "author": "Hueprint",
  "variables": {
    "bg": "#1e1408",
    "fg": "#e5dcd4",
    "accent": "#7b9dff",
    "muted": "#877768",
    "keyword": "#80c2ff",
    "string": "#c4b532",
