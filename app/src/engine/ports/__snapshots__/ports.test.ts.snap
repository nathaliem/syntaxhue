exports[`port sublime > matches its snapshot 1`] = `
[
  {
    "content": "{
  "name": "Fixture Dark",
  "author": "SyntaxHue",
  "variables": {
    "bg": "#23191c",
    "fg": "#e7dadd",
    "accent": "#00b9ce",
    "muted": "#8b7378",
    "keyword": "#ff967c",
    "string": "#ed8e21",
    "function": "#e87dd7",
    "type": "#d2a300",
    "variable": "#f5c2c9",
    "constant": "#c489ff",
    "operator": "#d5ada2",
    "error": "#f66d67",
    "warning": "#f2af48",
    "info": "#5fb8f2",
    "success": "#74c878",
    "border": "#3b3033",
    "widget": "#2d2225",
    "sidebar": "#1c1215"
  },
  "globals": {
    "background": "var(bg)",
    "foreground": "var(fg)",
    "caret": "var(accent)",
    "accent": "var(accent)",
    "line_highlight": "#e7dadd0d",
    "selection": "#00b9ce4d",
    "inactive_selection": "#00b9ce26",
    "selection_border": "var(accent)",
    "find_highlight": "var(warning)",
    "find_highlight_foreground": "var(bg)",
    "highlight": "var(warning)",
    "invisibles": "#8b737866",
    "guide": "#e7dadd14",
    "active_guide": "#e7dadd38",
    "stack_guide": "#e7dadd24",
    "brackets_foreground": "var(accent)",
    "brackets_options": "underline",
    "bracket_contents_foreground": "var(accent)",
    "tags_foreground": "var(type)",
    "misspelling": "var(error)",
    "gutter": "var(bg)",
    "gutter_foreground": "var(muted)",
    "shadow": "#00000040"
  },
  "rules": [
    {
      "name": "Comments",
      "scope": "comment, punctuation.definition.comment, markup.quote",
      "foreground": "var(muted)",
      "font_style": "italic"
    },
    {
      "name": "Keyword",
      "scope": "keyword, storage, storage.type, storage.modifier, keyword.control",
      "foreground": "var(keyword)",
      "font_style": "italic"
    },
    {
      "name": "String",
      "scope": "string, string.regexp, punctuation.definition.string, markup.inline.raw",
      "foreground": "var(string)"
    },
    {
      "name": "Function",
      "scope": "entity.name.function, support.function, meta.function-call",
      "foreground": "var(function)"
    },
    {
      "name": "Type",
      "scope": "entity.name.type, entity.name.class, entity.name.namespace, support.type, support.class, entity.other.inherited-class",
      "foreground": "var(type)"
    },
    {
      "name": "Variable",
      "scope": "variable, variable.parameter, variable.other.property, meta.object-literal.key",
      "foreground": "var(variable)"
    },
    {
      "name": "Number",
      "scope": "constant.numeric, constant.language, constant.character, constant.other, support.constant, variable.other.constant, markup.underline.link",
      "foreground": "var(constant)"
    },
    {
      "name": "Operator",
      "scope": "keyword.operator, punctuation, meta.brace",
      "foreground": "var(operator)"
    },
    {
      "name": "Type",
      "scope": "entity.name.tag",
      "foreground": "var(type)"
    },
    {
      "name": "Function",
      "scope": "entity.other.attribute-name, entity.name.section, markup.heading",
      "foreground": "var(function)"
    },
    {
      "name": "Invalid and deleted",
      "scope": "invalid, markup.deleted, meta.diff.deleted",
      "foreground": "var(error)"
    },
    {
      "name": "Deprecated and changed",
      "scope": "invalid.deprecated, markup.changed",
      "foreground": "var(warning)"
    },
    {
      "name": "Inserted",
      "scope": "markup.inserted, meta.diff.inserted",
      "foreground": "var(success)"
    },
    {
      "name": "Diff headers",
      "scope": "meta.diff.header, meta.diff.range",
      "foreground": "var(info)"
    }
  ]
}
",
    "path": "fixture-dark.sublime-color-scheme",
  },
]
`;

